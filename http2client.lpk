<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="/"/>
    <Name Value="http2client"/>
    <Type Value="RunAndDesignTime"/>
    <Author Value="lscoughlin"/>
    <Description Value="HTTP/2 client library for Free Pascal 3.2.4+ (ALPN via mORMot2/OpenSSL)"/>
    <Version Value="0.1.0"/>
    <License Value="MIT"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <IncludeFiles Value="src"/>
        <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
        <OtherUnitFiles Value="src;third_party/mORMot2/src/core;third_party/mORMot2/src/lib;third_party/mORMot2/src/net;third_party/mORMot2/src/crypt"/>
      </SearchPaths>
      <Parsing>
        <SyntaxOptions>
          <SyntaxMode Value="Delphi"/>
          <IncludeAssertionCode Value="True"/>
        </SyntaxOptions>
      </Parsing>
    </CompilerOptions>
    <Files Count="11">
      <Item1>
        <Filename Value="src/Http2.pas"/>
        <UnitName Value="Http2"/>
      </Item1>
      <Item2>
        <Filename Value="src/Http2.Errors.pas"/>
        <UnitName Value="Http2.Errors"/>
      </Item2>
      <Item3>
        <Filename Value="src/Http2.Frames.pas"/>
        <UnitName Value="Http2.Frames"/>
      </Item3>
      <Item4>
        <Filename Value="src/Http2.Headers.pas"/>
        <UnitName Value="Http2.Headers"/>
      </Item4>
      <Item5>
        <Filename Value="src/Http2.Hpack.pas"/>
        <UnitName Value="Http2.Hpack"/>
      </Item5>
      <Item6>
        <Filename Value="src/Http2.FlowControl.pas"/>
        <UnitName Value="Http2.FlowControl"/>
      </Item6>
      <Item7>
        <Filename Value="src/Http2.Tls.pas"/>
        <UnitName Value="Http2.Tls"/>
      </Item7>
      <Item8>
        <Filename Value="src/Http2.Connection.pas"/>
        <UnitName Value="Http2.Connection"/>
      </Item8>
      <Item9>
        <Filename Value="src/Http2.Stream.pas"/>
        <UnitName Value="Http2.Stream"/>
      </Item9>
      <Item10>
        <Filename Value="src/Http2.Observer.pas"/>
        <UnitName Value="Http2.Observer"/>
      </Item10>
      <Item11>
        <Filename Value="src/Http2.Client.pas"/>
        <UnitName Value="Http2.Client"/>
      </Item11>
    </Files>
    <RequiredPkgs Count="1">
      <Item1>
        <PackageName Value="FCL"/>
      </Item1>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
